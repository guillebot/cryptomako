<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Host app is NOT sandboxed: macFUSE mounts and launching Homebrew rclone
	     require it. The File Provider appex keeps its own sandbox entitlements. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- macFUSE.framework is signed by a different Team ID than CryptoMako. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.net.gschimmel.cryptomako</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.net.gschimmel.cryptomako</string>
	</array>
</dict>
</plist>
