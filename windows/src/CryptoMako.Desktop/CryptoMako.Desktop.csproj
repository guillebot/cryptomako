<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CryptoMako.Desktop</RootNamespace>
    <AssemblyName>CryptoMako.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Product>CryptoMako</Product>
    <AssemblyTitle>CryptoMako</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PlatformTarget Condition="'$(Platform)' == 'AnyCPU' or '$(Platform)' == ''">x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unpackaged WinUI: Content without CopyToOutputDirectory is omitted from publish — tray then falls back to ms-appx:/// and crashes (0x80070002) after the window appears. -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tray.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tray-windows.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CryptoMako.App\CryptoMako.App.csproj" />
    <!-- Force WinRT CfApi TFM — without this, net8.0-windows10.0.26100 Desktop falls back to net8.0 CfApi (no WinRT SyncRootManager). -->
    <ProjectReference Include="..\CryptoMako.CfApi\CryptoMako.CfApi.csproj"
                      SetTargetFramework="TargetFramework=net8.0-windows10.0.19041.0"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
</Project>
