<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CryptoMako.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CryptoMako"
    mc:Ignorable="d">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!-- Top padding 0 so AppTitleBar reaches the caption area for drag. -->
  <Grid x:Name="RootGrid" Padding="12,0,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Draggable title bar (SetTitleBar). Lamps stay on the right; no big badges. -->
    <Border x:Name="AppTitleBar" Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="0,0,8,8" Padding="12,10" Margin="0,0,0,8"
            MinHeight="48"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <!-- Right margin keeps lamps clear of system min/max/close. -->
      <Grid Margin="0,0,120,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="CryptoMako" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="StatusBarText" Opacity="0.85" Text="locked" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <!-- Outer Spacing = gap after each lamp before the next status label; inner Spacing = label to own lamp. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="DNS" Opacity="0.7" VerticalAlignment="Center"
                       ToolTipService.ToolTip="DNS resolve of S3 endpoint host" />
            <Ellipse x:Name="LampDns" Width="12" Height="12" Fill="Gray" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="TCP" Opacity="0.7" VerticalAlignment="Center"
                       ToolTipService.ToolTip="TCP connect to S3 endpoint port" />
            <Ellipse x:Name="LampTcp" Width="12" Height="12" Fill="Gray" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="HTTPS" Opacity="0.7" VerticalAlignment="Center"
                       ToolTipService.ToolTip="HTTPS / TLS to S3 endpoint" />
            <Ellipse x:Name="LampHttps" Width="12" Height="12" Fill="Gray" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="S3" Opacity="0.7" VerticalAlignment="Center"
                       ToolTipService.ToolTip="ListObjects on vault prefix (encrypted Cryptomator names)" />
            <Ellipse x:Name="LampList" Width="12" Height="12" Fill="Gray" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Unlocked" Opacity="0.7" VerticalAlignment="Center"
                       ToolTipService.ToolTip="Vault unlocked - can list cleartext / plaintext names" />
            <Ellipse x:Name="LampUnlocked" Width="12" Height="12" Fill="Gray" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Explorer" Opacity="0.7" VerticalAlignment="Center"
                       ToolTipService.ToolTip="Soft CfAPI Explorer sync-root connected" />
            <Ellipse x:Name="LampExplorer" Width="12" Height="12" Fill="Gray" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Spacer row kept for layout stability (status lives in top bar now). -->
    <Border Grid.Row="1" Height="0" Margin="0" />

    <Pivot Grid.Row="2">
      <PivotItem Header="Vault">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MaxHeight="420" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,0,8">
            <StackPanel Spacing="8">
              <TextBlock Text="Vault" FontSize="18" FontWeight="SemiBold" />
              <TextBlock TextWrapping="Wrap" Opacity="0.8"
                         Text="Unlock a Cryptomator format-8 vault (local or S3). Secrets never go in settings.json." />

              <TextBlock Text="Storage mode" FontWeight="SemiBold" Margin="0,4,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="20">
                <RadioButton x:Name="ModeLocalRadio" Content="Local folder" GroupName="VaultStorageMode"
                             Click="OnModeLocal" VerticalAlignment="Center"
                             ToolTipService.ToolTip="Use a vault directory on this PC (storageMode=local)" />
                <RadioButton x:Name="ModeS3Radio" Content="S3 / remote object store" GroupName="VaultStorageMode"
                             Click="OnModeS3" VerticalAlignment="Center"
                             ToolTipService.ToolTip="Cryptomator vault on S3-compatible storage (storageMode=s3)" />
              </StackPanel>
              <TextBlock x:Name="StorageModeText" Opacity="0.75" FontFamily="Consolas" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LocalPathLabel" Grid.Row="0" Text="Local path" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="LocalVaultPathBox" Margin="0,0,0,8" />

                <TextBlock x:Name="EndpointLabel" Grid.Row="1" Text="Endpoint" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="EndpointBox" PlaceholderText="https://" Margin="0,0,0,8" />

                <TextBlock x:Name="RegionBucketLabel" Grid.Row="2" Text="Region / Bucket" VerticalAlignment="Center" Margin="0,0,0,8" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <TextBox x:Name="RegionBox" Width="160" />
                  <TextBox x:Name="BucketBox" Width="200" PlaceholderText="bucket" />
                </StackPanel>

                <TextBlock x:Name="PrefixAccessLabel" Grid.Row="3" Text="Prefix / Access" VerticalAlignment="Center" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <TextBox x:Name="PrefixBox" Width="200" />
                  <TextBox x:Name="AccessKeyBox" Width="200" PlaceholderText="access key" />
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Password" VerticalAlignment="Center" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <PasswordBox x:Name="PasswordBox" Width="240" PasswordChanged="OnPasswordChanged" />
                  <CheckBox x:Name="PathStyleCheck" Content="path-style" />
                  <CheckBox x:Name="AutoReconnectCheck" Content="auto-reconnect" Click="OnAutoReconnectClick" />
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save settings" Click="OnSaveSettings" />
                <Button Content="Save password" Click="OnSavePassword" />
                <Button x:Name="UnlockButton" Content="Unlock" Click="OnUnlock" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="LockButton" Content="Lock" Click="OnLock" IsEnabled="False" />
                <Button Content="Probe S3" Click="OnProbe" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConnectExplorerButton" Content="Connect Explorer" Click="OnConnectExplorer" IsEnabled="False" />
                <Button x:Name="DisconnectExplorerButton" Content="Disconnect Explorer" Click="OnDisconnectExplorer" IsEnabled="False" />
                <HyperlinkButton x:Name="ExplorerPathLink" Content="Open sync root"
                                 Click="OnOpenExplorerPath" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Opacity="0.75"
                           Text="Soft CfAPI viewer. Lock disconnects automatically (no CredMan wipe)." />
              </StackPanel>

              <TextBlock x:Name="RemoteHintText" Foreground="OrangeRed" FontWeight="SemiBold" />
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="1" MinHeight="120">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Log" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Grid.Row="1" x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True"
                     TextWrapping="Wrap" FontFamily="Consolas" VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch" MinHeight="80"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </Grid>
        </Grid>
      </PivotItem>

      <PivotItem Header="Backup">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="Backup Sync" FontSize="18" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Encrypt local folders into Backups/{folder}/. Fail-closed remote puts. Nested/overlapping sources soft-warn on add and hard-fail on Sync." />
          <TextBlock x:Name="BackupRemoteHintText" Foreground="OrangeRed" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="BackupOverlapBannerText" Foreground="DarkOrange" FontWeight="SemiBold"
                     TextWrapping="Wrap" Visibility="Collapsed" />
          <TextBlock Text="Sources" FontWeight="SemiBold" />
          <ListBox x:Name="BackupSourcesList" Height="110" FontFamily="Consolas"
                   SelectionMode="Single" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Remove selected" Click="OnRemoveBackupSource" />
            <Button Content="Clear sources" Click="OnClearBackupSources" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Add path" Width="100" VerticalAlignment="Center" />
            <TextBox x:Name="BackupSourceBox" Width="420" PlaceholderText="path to cleartext folder" />
            <Button Content="Browse..." Click="OnBrowseBackupSource" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Vault folder" Width="100" VerticalAlignment="Center" />
            <TextBox x:Name="VaultFolderBox" Width="240" />
            <Button Content="Add source" Click="OnAddBackupSource" />
          </StackPanel>
          <Button x:Name="SyncNowButton" Content="Sync now" HorizontalAlignment="Left" Click="OnSync" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="Requires an unlocked vault" />
          <StackPanel x:Name="BackupProgressPanel" Spacing="4" Visibility="Collapsed">
            <TextBlock x:Name="BackupProgressLabelText" FontWeight="SemiBold" />
            <ProgressBar x:Name="BackupProgressBar" Minimum="0" Maximum="100" Height="8" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock x:Name="BackupSpeedText" Opacity="0.8" />
              <TextBlock x:Name="BackupEtaText" Opacity="0.8" />
            </StackPanel>
            <TextBlock x:Name="BackupCurrentPathText" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </PivotItem>

      <PivotItem Header="Settings">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="Preferences" FontSize="18" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Platforms-locked keys. Proxy password: CRYPTOMAKO_PROXY_PASSWORD." />
          <TextBlock Text="Proxy" FontWeight="SemiBold" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton x:Name="ProxyOffRadio" Content="Off" GroupName="ProxyMode" Click="OnProxyModeClick"
                         ToolTipService.ToolTip="direct - no proxy (proxyMode=direct)" />
            <RadioButton x:Name="ProxySystemRadio" Content="System" GroupName="ProxyMode" Click="OnProxyModeClick"
                         ToolTipService.ToolTip="Use OS system proxy (proxyMode=system)" />
            <RadioButton x:Name="ProxyCustomRadio" Content="Custom" GroupName="ProxyMode" Click="OnProxyModeClick"
                         ToolTipService.ToolTip="Manual host/port (proxyMode=custom)" />
          </StackPanel>
          <StackPanel x:Name="ProxyCustomPanel" Spacing="8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Host" Width="140" VerticalAlignment="Center" />
              <TextBox x:Name="ProxyHostBox" Width="220" PlaceholderText="proxy.example.com" />
              <TextBlock Text="Port" VerticalAlignment="Center" />
              <TextBox x:Name="ProxyPortBox" Width="80" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Username" Width="140" VerticalAlignment="Center" />
              <TextBox x:Name="ProxyUserBox" Width="200" PlaceholderText="optional" />
            </StackPanel>
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                       Text="Proxy password (if needed): store as CRYPTOMAKO_PROXY_PASSWORD in Credential Manager - not written to settings.json." />
          </StackPanel>
          <TextBox x:Name="ProxyModeBox" Visibility="Collapsed" Width="1" Height="1" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox x:Name="LimitUploadCheck" Content="Limit upload" />
            <TextBlock Text="Mbps" VerticalAlignment="Center" />
            <TextBox x:Name="UploadCapBox" Width="80" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Workers S/M/L" Width="140" VerticalAlignment="Center" />
            <TextBox x:Name="WorkersSBox" Width="60" />
            <TextBox x:Name="WorkersMBox" Width="60" />
            <TextBox x:Name="WorkersLBox" Width="60" />
          </StackPanel>
          <Button Content="Save preferences" HorizontalAlignment="Left" Click="OnSaveSettings" />
          <TextBlock Margin="0,16,0,0" Opacity="0.75" TextWrapping="Wrap"
                     Text="Tray: Open / Unlock / Lock / Probe S3 / status labels / Quit. Close and minimize hide to tray." />
          <TextBlock Opacity="0.75" TextWrapping="Wrap"
                     Text="Cloud Files (CfAPI): soft Explorer viewer. See docs/cfapi.md." />
        </StackPanel>
      </PivotItem>
    </Pivot>
  </Grid>
</Window>
